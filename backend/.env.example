FLASK_ENV=production
DATABASE_URL=postgresql://...
PIXEL_SECRET_KEY=...
JWT_ISSUER=pixel-planner
JWT_ACCESS_TTL_SECONDS=3600
JWT_REFRESH_TTL_SECONDS=2592000
APP_VERSION=5.0.6
APP_BUILD=50006
APP_DOWNLOAD_URL=
QWEATHER_PRIVATE_KEY=...
QWEATHER_KID=...
QWEATHER_PROJECT_ID=...
BACKDOOR_PHONE=...
BACKDOOR_CODE=...
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
# Comma-separated fallback models, tried from left to right.
OPENAI_MODEL=gpt-4o-mini
# Optional comma-separated vision-capable models for meal and ticket OCR.
OPENAI_VISION_MODELS=
# Optional JSON list of backup OpenAI-compatible relays. Never commit real keys.
# LLM_PROVIDERS=[{"name":"backup","api_key":"...","base_url":"https://relay.example/v1","models":["model-a","model-b"]}]
